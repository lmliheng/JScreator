{
    "name": "JScreate",
    "version": "1.0.2",
    "description": "Node web backApp",
    "main": "server.js",
    "author": "lmliheng",
    "license": "MIT",
    "scripts": {
        "dev": "nodemon server.js --dev",
        "test": "node test",
        "build": "rollup -c",
        "ts:build": "tsc -p tsconfig.json",
        "start:ts": "node Backend/dist/server.js",
        "watch:ts": "tsc -p tsconfig.json --watch",
        "test:ts": "tsc -p tsconfig.json && node --test --test-force-exit Backend/dist/contract.test.js Backend/dist/db/transaction.test.js Backend/dist/common/errors.test.js Backend/dist/common/response.test.js Backend/dist/common/middleware/auth.test.js Backend/dist/modules/auth/auth.service.test.js Backend/dist/modules/article/article.service.test.js",
        "db:export": "node scripts/db-sync.js export",
        "db:import": "node scripts/db-sync.js import",
        "db:list": "node scripts/db-sync.js list"
    },
    "dependencies": {
        "ali-oss": "^6.23.0",
        "archiver": "^6.0.2",
        "axios": "^1.16.0",
        "cors": "^2.8.5",
        "crypto-js": "^4.2.0",
        "dotenv": "^16.3.1",
        "express": "^4.18.2",
        "jsonwebtoken": "^9.0.2",
        "multer": "^2.2.0",
        "mysql2": "^3.6.5",
        "mysqldump": "^3.2.0",
        "nodemailer": "^9.0.5",
        "nodemon": "^3.1.2",
        "openai": "^6.36.0",
        "otplib": "^12.0.1",
        "ws": "^8.21.3"
    },
    "devDependencies": {
        "@types/cors": "^2.8.19",
        "@types/express": "^4.17.25",
        "@types/node": "^20.19.43",
        "rollup": "^4.62.5",
        "typescript": "^5.9.3"
    }
}
